# Chave para assinar tokens de login. Sem ela, uma chave efêmera é gerada a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio
# Token exigido no header X-Admin-Token pelos endpoints DELETE e para definir role admin/manager.
# Vazio → essas operações ficam desabilitadas (403).
ADMIN_TOKEN=
# URI do banco (relativa à pasta instance/ para sqlite).
DATABASE_URL=sqlite:///tasks.db
# Origens permitidas para CORS, separadas por vírgula. Vazio → CORS desabilitado.
CORS_ORIGINS=
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
