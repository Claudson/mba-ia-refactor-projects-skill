# Porta HTTP (padrão: 3000)
PORT=3000

# Arquivo SQLite; ":memory:" recria schema e seed a cada boot (padrão)
DATABASE_PATH=:memory:

# Chave do gateway de pagamento; vazia → gateway em modo simulado
PAYMENT_GATEWAY_KEY=

# Token exigido no header X-Admin-Token em /api/admin/* e DELETE /api/users/:id;
# vazio → esses endpoints respondem 403
ADMIN_TOKEN=troque-por-um-token-longo-e-aleatorio

# Nível de log: debug | info | warn | error
LOG_LEVEL=info
