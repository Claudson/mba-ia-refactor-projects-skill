# Copie para .env (ou exporte no ambiente) e ajuste os valores.
# Todas as variaveis tem default seguro, exceto os segredos.

# Chave de assinatura do Flask. Ausente -> chave efemera gerada no boot (com warning).
SECRET_KEY=troque-por-uma-chave-aleatoria

# Modo debug. NUNCA ligar em producao (expoe o debugger do Werkzeug).
FLASK_DEBUG=false

# Bind do servidor. Default seguro: apenas loopback.
HOST=127.0.0.1
PORT=5000

# Caminho do arquivo SQLite.
DATABASE_PATH=loja.db

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Token exigido no header X-Admin-Token por /admin/reset-db e /admin/query.
# Ausente -> endpoints administrativos desabilitados (403).
ADMIN_TOKEN=

# Origens permitidas no CORS, separadas por virgula. Vazio -> CORS desabilitado.
CORS_ORIGINS=
