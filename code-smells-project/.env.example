# Chave de assinatura do Flask. Sem ela, uma chave efêmera é gerada a cada boot.
SECRET_KEY=troque-por-um-valor-aleatorio-longo
# Token exigido no header X-Admin-Token de POST /admin/reset-db. Vazio = endpoint desabilitado (403).
ADMIN_TOKEN=troque-por-um-token-de-admin
# Debugger do Werkzeug: nunca habilitar fora de desenvolvimento.
DEBUG=false
HOST=127.0.0.1
PORT=5000
DATABASE_PATH=loja.db
# Origens liberadas para CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
LOG_LEVEL=INFO
